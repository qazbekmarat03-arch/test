<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Интерактивті Математика Курсы</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0fdf4; /* Very light green */
            background-image:
                radial-gradient(circle at 1px 1px, rgba(0, 128, 0, 0.1) 1px, transparent 0),
                radial-gradient(circle at 15px 15px, rgba(0, 128, 0, 0.1) 1px, transparent 0);
            background-size: 30px 30px;
        }
        .gradient-btn {
            background-image: linear-gradient(to right, #22c55e, #16a34a);
            transition: all 0.3s ease;
        }
        .gradient-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(22, 163, 74, 0.2), 0 4px 6px -2px rgba(22, 163, 74, 0.1);
        }
        .progress-bar-inner {
            transition: width 0.5s ease-in-out;
        }
        .lesson-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .lesson-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .completed-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2rem;
            font-weight: bold;
            color: #16a34a;
            border-radius: 0.75rem;
            backdrop-filter: blur(2px);
        }
    </style>
</head>
<body class="text-gray-800">

        <div id="login-container" class="min-h-screen flex items-center justify-center bg-gray-100" style="background-color: #f0fdf4;">
        <div class="bg-white p-8 sm:p-10 rounded-2xl shadow-xl w-full max-w-sm">
            <h1 class="text-3xl font-bold text-green-700 mb-2 text-center">Математика</h1>
            <p class="text-gray-600 mb-6 text-center">Курсқа кіру үшін деректерді енгізіңіз</p>
            <form id="login-form" class="space-y-4">
                <input id="email-input" type="email" placeholder="Email мекенжайыңыз" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                <input id="code-input" type="text" placeholder="Сізге берілген жеке код" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500" required>
                <button id="login-btn" type="submit" class="w-full gradient-btn text-white font-semibold py-3 px-4 rounded-lg shadow-md">
                    Кіру
                </button>
            </form>
        </div>
    </div>

        <div id="app-container" class="hidden">
        <header class="bg-white/80 backdrop-blur-sm sticky top-0 z-10 shadow-md py-4 px-4 sm:px-8">
            <div class="container mx-auto flex flex-col sm:flex-row justify-between items-center">
                <h1 class="text-2xl sm:text-3xl font-bold text-green-700 mb-4 sm:mb-0">Интерактивті Математика Курсы</h1>
                <div class="flex items-center space-x-4">
                    <div class="text-right">
                        <p id="user-email" class="text-sm font-medium text-gray-700"></p>
                        <button id="logout-btn" class="text-xs text-red-600 hover:underline">Шығу</button>
                    </div>
                </div>
            </div>
            <div class="container mx-auto mt-4">
                <p class="text-sm font-medium mb-1">Сіздің прогрессіңіз:</p>
                <div class="w-full bg-gray-200 rounded-full h-4">
                    <div id="progress-bar" class="bg-gradient-to-r from-green-400 to-emerald-600 h-4 rounded-full progress-bar-inner" style="width: 0%;"></div>
                </div>
                <p id="progress-text" class="text-right text-xs mt-1 font-semibold text-green-700">0/16 сабақ аяқталды</p>
            </div>
        </header>

        <main id="lessons-grid" class="container mx-auto p-4 sm:p-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    </main>
    </div>
    
        <div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex justify-center items-center p-4">
        <div class="bg-white p-6 rounded-lg shadow-xl text-center w-full max-w-sm">
            <p id="modal-message" class="mb-4 text-lg"></p>
            <button id="modal-close-btn" class="bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700">Түсінікті</button>
        </div>
    </div>


    <script type="module">
        // Firebase 11.6.1 SDK
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // --- МАҢЫЗДЫ: FIREBASE ОРНАТУ ---
        // ... (Firebase конфигурациясы туралы ақпарат)
        
        const firebaseConfig = typeof __firebase_config !== 'undefined' 
            ? JSON.parse(__firebase_config)
            : {
                apiKey: "AIzaSyAyRg4CUZuhnuWR2AWk6FYltx-b5s2Tqeo",
                authDomain: "durystap2025.firebaseapp.com",
                projectId: "durystap2025",
                storageBucket: "durystap2025.firebasestorage.app", // Corrected
                messagingSenderId: "758596577131",
                appId: "1:758596577131:web:312e6fa16454bd090d4e2e",
                measurementId: "G-FVK0TD21ZF"
            };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-math-app';

        // DOM Elements
        const loginContainer = document.getElementById('login-container');
        const appContainer = document.getElementById('app-container');
        const loginForm = document.getElementById('login-form');
        const emailInput = document.getElementById('email-input');
        const codeInput = document.getElementById('code-input');
        const logoutBtn = document.getElementById('logout-btn');
        const userEmailEl = document.getElementById('user-email');
        const lessonsGrid = document.getElementById('lessons-grid');
        const progressBar = document.getElementById('progress-bar');
        const progressText = document.getElementById('progress-text');
        const modal = document.getElementById('modal');
        const modalMessage = document.getElementById('modal-message');
        const modalCloseBtn = document.getElementById('modal-close-btn');

        // Course Data
        const lessons = [
            { id: 1, title: 'Сабақ 1', video: 'https://www.youtube.com/watch?v=L14Ef4XNUiE', homework: 'https://drive.google.com/file/d/12or8f_KloqF-ADdHHTfsHmqB0rZPjv0d/view?usp=sharing' },
            { id: 2, title: 'Сабақ 2', video: 'https://www.youtube.com/watch?v=lZ1fIuAUvoU', homework: 'https://drive.google.com/file/d/1cUd4lz3SwfnNokcOFID-gHXl1rn_iHTs/view?usp=sharing' },
            { id: 3, title: 'Сабақ 3', video: 'https://www.youtube.com/watch?v=JyYO_RgOVzM', homework: 'https://drive.google.com/file/d/1qDiTrkHkGCGxCfG42IbSekfep8UncS65/view?usp=sharing' },
            { id: 4, title: 'Сабақ 4', video: 'https://www.youtube.com/watch?v=-0DwOFr6KoQ', homework: 'https://drive.google.com/file/d/1EI_cNvJPnG3hZw0Lt1nvIq7b1FmyHULF/view?usp=sharing' },
            { id: 5, title: 'Сабақ 5', video: 'https://www.youtube.com/watch?v=AyG-cp9Vgjk', homework: 'https://drive.google.com/file/d/1RQG1yFGxQjDkScnZzs-o-_EKKUp1oxBc/view?usp=sharing' },
            { id: 6, title: 'Сабақ 6', video: 'https://www.youtube.com/watch?v=r5uE_hfMhSY', homework: 'https://drive.google.com/file/d/1DNS6cLa5VYeYJiMK5jVsq-RVZyJPr6AJ/view?usp=sharing' },
            { id: 7, title: 'Сабақ 7', video: 'https://www.youtube.com/watch?v=hKU_GdtC_8I', homework: 'https://drive.google.com/file/d/1HDN5we9QfP0MxA7lpTRsWK3xN1biZU8x/view?usp=sharing' },
            { id: 8, title: 'Сабақ 8', video: 'https://www.youtube.com/watch?v=4gbTyCtB-xQ', homework: 'https://drive.google.com/file/d/1W8QeTomo73m3Y-wFFUWNPJ1QKcESCyry/view?usp=sharing' },
            { id: 9, title: 'Сабақ 9', video: 'https://www.youtube.com/watch?v=vugvvFlvkyg', homework: 'https://drive.google.com/file/d/11sH3w3Csrqhka7rRDHiRoDGecPx11JJH/view?usp=sharing' },
            { id: 10, title: 'Сабақ 10', video: 'https://www.youtube.com/watch?v=I0WwWXfvlUY', homework: 'https://drive.google.com/file/d/11sH3w3Csrqhka7rRDHiRoDGecPx11JJH/view?usp=sharing' },
            { id: 11, title: 'Сабақ 11', video: 'https://www.youtube.com/watch?v=xh22Z_4I5Lg', homework: 'https://drive.google.com/file/d/1Wh7P_Fz8lhoDl5nlb5C5WDgmyqa0Qnna/view?usp=sharing' },
            { id: 12, title: 'Сабақ 12', video: 'https://www.youtube.com/watch?v=UKP7Wt2-U2M', homework: 'https://drive.google.com/file/d/1NHJTn-cKDTliElPstJqr4MuoMvQmaPai/view?usp=sharing' },
            { id: 13, title: 'Сабақ 13', video: 'https://www.youtube.com/watch?v=WrRCQaRktRs', homework: 'https://drive.google.com/file/d/1h7xj40OxpkGeLzBeqQxT2f-TNwdZOJE9/view?usp=sharing' },
            { id: 14, title: 'Сабақ 14', video: 'https://www.youtube.com/watch?v=t9vDWy-h_nQ', homework: null },
            { id: 15, title: 'Сабақ 15', video: 'https://www.youtube.com/watch?v=NIvFXIdjDDU', homework: null },
            { id: 16, title: 'Сабақ 16', video: 'https://www.youtube.com/watch?v=eciVBVMv3Vo', homework: 'https://drive.google.com/file/d/13lg7xuyXqjUNBZzVFOQtVNbbXtAxEg7A/view?usp=sharing' },
        ];
        
        let userProgress = [];
        let unsubscribeProgress;

        // Functions
        function showModal(message) {
            modalMessage.textContent = message;
            modal.classList.remove('hidden');
        }

        modalCloseBtn.addEventListener('click', () => modal.classList.add('hidden'));
        
        function renderLessons() {
            lessonsGrid.innerHTML = '';
            lessons.forEach(lesson => {
                const isCompleted = userProgress.includes(lesson.id);
                const homeworkButton = lesson.homework 
                    ? `<a href="${lesson.homework}" target="_blank" rel="noopener noreferrer" class="gradient-btn mt-4 inline-block text-white font-semibold py-2 px-5 rounded-lg shadow-md w-full text-center">Үй тапсырмасы</a>`
                    : `<div class="mt-4 text-center text-gray-500 italic py-2 px-5 w-full">Үй тапсырмасы жоқ</div>`;

                const card = `
                    <div class="lesson-card bg-white rounded-xl shadow-lg overflow-hidden relative">
                        <div class="p-5">
                            <h3 class="text-xl font-bold text-gray-800 mb-2">${lesson.title}</h3>
                            <a href="${lesson.video}" target="_blank" rel="noopener noreferrer" class="text-green-600 hover:text-green-800 font-medium flex items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" /></svg>
                                Видеосабақты көру
                            </a>
                            ${homeworkButton}
                                                        <button data-id="${lesson.id}" class="complete-btn w-full mt-3 py-2 px-4 rounded-md font-semibold ${isCompleted ? 'bg-red-100 text-red-700 hover:bg-red-200' : 'bg-gray-200 text-gray-700 hover:bg-green-200'}">
                                ${isCompleted ? 'Аяқталды (Бас тарту)' : 'Аяқталды деп белгілеу'}
                            </button>
                        </div>
                        ${isCompleted ? '<div class="completed-overlay">✔️ Аяқталды</div>' : ''}
                    </div>
                `;
                lessonsGrid.insertAdjacentHTML('beforeend', card);
            });
        }
        
        function updateProgress() {
            const completedCount = userProgress.length;
            const totalCount = lessons.length;
            const percentage = totalCount > 0 ? (completedCount / totalCount) * 100 : 0;
            
            progressBar.style.width = `${percentage}%`;
            progressText.textContent = `${completedCount}/${totalCount} сабақ аяқталды`;
            renderLessons();
        }
        
        function setupProgressListener(userEmail) {
            if (unsubscribeProgress) unsubscribeProgress();
            
            const safeEmail = encodeURIComponent(userEmail);
            const progressDocRef = doc(db, `artifacts/${appId}/users/${safeEmail}/progress`, 'lessons');
            
            unsubscribeProgress = onSnapshot(progressDocRef, (docSnap) => {
                userProgress = docSnap.exists() ? docSnap.data().completed || [] : [];
                updateProgress();
            }, (error) => {
                console.error("Error listening to progress:", error);
            });
        }

        async function toggleComplete(lessonId) {
            const userEmail = sessionStorage.getItem('mathUserEmail');
            if (!userEmail) return;

            const updatedProgress = userProgress.includes(lessonId)
                ? userProgress.filter(id => id !== lessonId)
                : [...userProgress, lessonId];
            
            try {
                 const safeEmail = encodeURIComponent(userEmail);
                 const progressDocRef = doc(db, `artifacts/${appId}/users/${safeEmail}/progress`, 'lessons');
                 await setDoc(progressDocRef, { completed: updatedProgress }, { merge: true });
            } catch(e) {
                console.error("Error updating progress:", e);
                showModal("Прогрессті жаңарту кезінде қате кетті.");
            }
        }
        
        async function handleLogin(event) {
            event.preventDefault();
            const email = emailInput.value.trim().toLowerCase();
            const code = codeInput.value.trim();

            if (!email || !code) {
                showModal('Email мен кодты толық енгізіңіз.');
                return;
            }

            try {
                const docRef = doc(db, "access_codes", email);
                const docSnap = await getDoc(docRef);

                if (docSnap.exists() && docSnap.data().code === code) {
                    sessionStorage.setItem('mathUserEmail', email);
                    initializeAppView(email);
                } else {
                    showModal('Email немесе код қате. Деректерді тексеріп, қайталап көріңіз.');
                }
            } catch (error) {
                console.error("Login error:", error);
                showModal('Жүйеге кіру кезінде техникалық қате пайда болды.');
            }
        }

        function initializeAppView(email) {
            userEmailEl.textContent = email;
            loginContainer.classList.add('hidden');
            appContainer.classList.remove('hidden');
            setupProgressListener(email);
        }

        // --- Event Listeners and App Initialization ---
        loginForm.addEventListener('submit', handleLogin);
        
        logoutBtn.addEventListener('click', () => {
            sessionStorage.removeItem('mathUserEmail');
            window.location.reload();
        });
        
        // ӨЗГЕРІС ОСЫ ЖЕРДЕ: "if" шарты алынып тасталды
        lessonsGrid.addEventListener('click', (e) => {
            if (e.target && e.target.classList.contains('complete-btn')) {
                const lessonId = parseInt(e.target.dataset.id);
                // `if (!userProgress.includes(lessonId))` шарты алынды.
                // Енді батырма әрқашан toggleComplete функциясын шақырады.
                toggleComplete(lessonId);
            }
        });

        // Main function to start the app
        async function main() {
            try {
                // Sign in anonymously to get permissions for Firestore
                await signInAnonymously(auth);
                console.log("Authenticated anonymously.");

                // Check for a logged-in user on page load
                const storedEmail = sessionStorage.getItem('mathUserEmail');
                if (storedEmail) {
                    initializeAppView(storedEmail);
                }
            } catch(error) {
                console.error("Authentication or initialization failed:", error);
                showModal("Қолданбаны іске қосу мүмкін болмады. Бетті қайта жүктеп көріңіз.");
            }
        }

        // Run the main function when the page is loaded
        document.addEventListener('DOMContentLoaded', main);

    </script>

</body>
</html>
